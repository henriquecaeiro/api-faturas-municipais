APP_NAME="Municipality Billing API Showcase"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=single
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

DB_CONNECTION=sqlite
DB_DATABASE=

ERP_DRIVER=mock
ERP_BASE_URL=
ERP_COMPANY=
ERP_USERNAME=
ERP_PASSWORD=
ERP_TIMEOUT=15
ERP_VERIFY_SSL=true
ERP_LOGIN_PATH=/Login
ERP_MUNICIPALITIES_ENDPOINT=/billing/municipalities
ERP_INSTALLMENTS_ENDPOINT=/billing/installments
ERP_BANK_SLIPS_ENDPOINT=/billing/bank-slips

BILLING_SYNC_CACHE_MINUTES=1440
